# PsychAvenuePH — Environment Variable Template
# Copy this file to .env.local and fill in all blank values before running the app.
# .env.local is git-ignored and will NEVER be committed.

# ─── API ──────────────────────────────────────────────────────────────────────
# Base URL of the deployed API Gateway (FastAPI via Lambda + Mangum).
# Source: infra teammate → run `tofu output api_endpoint` inside infra/environments/dev/
# Local dev: http://localhost:8000
NEXT_PUBLIC_API_URL=

# ─── AWS COGNITO ──────────────────────────────────────────────────────────────
# Source: infra teammate → run `tofu output` inside infra/environments/dev/

# Cognito User Pool ID (format: ap-southeast-1_XxXxXxXxX)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=

# Cognito App Client ID (long alphanumeric string, no dashes)
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# AWS Region — fixed to ap-southeast-1 per infra/environments/dev/dev.tfvars
NEXT_PUBLIC_COGNITO_REGION=ap-southeast-1
