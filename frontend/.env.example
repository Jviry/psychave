# PsychAvenuePH — Environment Variable Template
# Copy this file to .env.local and fill in all blank values before running the app.
# .env.local is git-ignored and will NEVER be committed.
#
# Quick-start (offline/mock mode — no backend needed):
#   cp .env.example .env.local
#   # leave NEXT_PUBLIC_AUTH_MODE=mock, run: npm run dev
#
# To connect to the real backend:
#   1. Fill in all variables below
#   2. Change NEXT_PUBLIC_AUTH_MODE from 'mock' to 'real'
#   3. Restart: npm run dev

# ─── API ──────────────────────────────────────────────────────────────────────
# Base URL of the deployed API Gateway (FastAPI via Lambda + Mangum).
# Source: infra teammate → run `tofu output api_endpoint` inside infra/environments/dev/
# Local dev: http://localhost:8000
NEXT_PUBLIC_API_URL=

# ─── AUTH MODE ────────────────────────────────────────────────────────────────
# 'mock'  → all API calls resolved in-memory; no network traffic; Cognito not needed
# 'real'  → all API calls go to NEXT_PUBLIC_API_URL; mocks disabled
# Keep 'mock' until NEXT_PUBLIC_API_URL + Cognito vars are confirmed working.
NEXT_PUBLIC_AUTH_MODE=mock

# ─── AWS COGNITO ──────────────────────────────────────────────────────────────
# Required when NEXT_PUBLIC_AUTH_MODE=real.
# Source: infra teammate → run `tofu output` inside infra/environments/dev/

# Cognito User Pool ID (format: ap-southeast-1_XxXxXxXxX)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=

# Cognito App Client ID (long alphanumeric string, no dashes)
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# AWS Region — fixed to ap-southeast-1 per infra/environments/dev/dev.tfvars
NEXT_PUBLIC_COGNITO_REGION=ap-southeast-1
