# Application Settings
APP_NAME="PsychAve API"
ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Local Supabase PostgreSQL Database (port 54322)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# CORS & Security
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
SECRET_KEY=temporary-secret-key

# AWS Cognito (Authentication)
AWS_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=ap-southeast-1_xxxxxxxxx
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Payment Providers (fake for local dev, paymongo for staging/prod)
PAYMENT_PROVIDER=fake
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_API_BASE_URL=https://api.paymongo.com/v1
FRONTEND_URL=http://localhost:3000

# Local Supabase Reference Endpoints
# DB Port: 54322
# Studio UI: http://127.0.0.1:54323
# API Gateway: http://127.0.0.1:54321
# Mailpit: http://127.0.0.1:54324
